# shellcheck disable=3043

setup_install() {
	# Setup overlay on /install
	local LOWER UPPER=/tmp/i_upperdir WORK=/tmp/i_workdir I=/install O="/mnt/$SRC/overlay"
	LOWER=$I
	if [ -d "$O" ]; then
		LOWER=$LOWER:$O
	fi
	mkdir -p $I $UPPER $WORK
	mount -o loop "/mnt/$SRC/$INSTALL" $I
	mount -t overlay \
		-o lowerdir=$LOWER,upperdir=$UPPER,workdir=$WORK \
		overlay $I

	# Move mountpoints
	mount --move /android $I/android
	mount --move /mnt $I/cdrom

	# Additional setup to bind system.img to /source
	if mountpoint -q /android; then
		mount --move /android $I/source
	else
		mount --bind $I/cdrom $I/source
	fi

	# Post setup
	rm -f /system
	ln -s $I/android/system /
}
